# Copy to .env and fill in. .env is never committed. Only Tomas's Mac needs
# these: uploading in the admin, the audio jobs and Bandcamp stock. The static
# build needs none of them (the deploy reads Bandcamp with GitHub secrets of
# the same names).

# Cloudflare R2 (dashboard: R2 > Manage API tokens; Object Read & Write on the
# two buckets below)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=margate-electronics-media
R2_MASTERS_BUCKET_NAME=margate-electronics-masters
R2_PUBLIC_DOMAIN=https://media.margate-electronics.org

# MailerLite (API token; only for checking sign-ups from the terminal)
MAILERLITE_API_KEY=

# Bandcamp (Settings > API Access): stock read by bin/publish and the deploy
BANDCAMP_CLIENT_ID=
BANDCAMP_CLIENT_SECRET=
